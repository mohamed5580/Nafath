@model Infrastructure.ViewModel.CompanyInformationViewModel

@{
    ViewData["Title"] = "معلومات الشركة";
}

<div class="row">
    <div class="col-12">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-building ml-2"></i> معلومات الشركة</h3>
            </div>

            <form asp-area="Admin" asp-controller="CompanyInformation" asp-action="Index" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="ExistingLogoUrl" type="hidden" />

                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-lg-8">
                            <div class="form-group">
                                <label asp-for="Name">الاسم</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Address"></label>
                                <input asp-for="Address" class="form-control" />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="MapUrl"></label>
                                <input asp-for="MapUrl" class="form-control" dir="ltr" placeholder="https://maps.google.com/..." />
                                <span asp-validation-for="MapUrl" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="PhoneNumber"></label>
                                        <input asp-for="PhoneNumber" class="form-control" dir="ltr" />
                                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Email"></label>
                                        <input asp-for="Email" class="form-control" dir="ltr" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="Description"></label>
                                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="OtherInformation"></label>
                                <textarea asp-for="OtherInformation" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="OtherInformation" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group text-center">
                                <label asp-for="LogoFile" class="d-block"></label>
                                <div class="border rounded p-3 mb-3 bg-light">
                                    <img id="companyLogoPreview"
                                         src="@(string.IsNullOrWhiteSpace(Model.ExistingLogoUrl) ? "/Nafas/assets/images/logoo.png" : Model.ExistingLogoUrl)"
                                         alt="شعار الشركة"
                                         class="img-fluid"
                                         style="max-height:180px;object-fit:contain;" />
                                </div>
                                <div class="custom-file">
                                    <input asp-for="LogoFile" class="custom-file-input" accept="image/jpeg,image/png,image/webp,image/gif" />
                                    <label class="custom-file-label" for="LogoFile">اختر شعاراً جديداً</label>
                                </div>
                                <span asp-validation-for="LogoFile" class="text-danger d-block"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="FacebookUrl"></label>
                                <input asp-for="FacebookUrl" class="form-control" dir="ltr" />
                                <span asp-validation-for="FacebookUrl" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="InstagramUrl"></label>
                                <input asp-for="InstagramUrl" class="form-control" dir="ltr" />
                                <span asp-validation-for="InstagramUrl" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="WebsiteUrl"></label>
                                <input asp-for="WebsiteUrl" class="form-control" dir="ltr" />
                                <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ClientsNumber"></label>
                                <input asp-for="ClientsNumber" class="form-control" min="0" />
                                <span asp-validation-for="ClientsNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ProjectsNumber"></label>
                                <input asp-for="ProjectsNumber" class="form-control" min="0" />
                                <span asp-validation-for="ProjectsNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="SupportHours"></label>
                                <input asp-for="SupportHours" class="form-control" min="0" />
                                <span asp-validation-for="SupportHours" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="EmployeesNumber"></label>
                                <input asp-for="EmployeesNumber" class="form-control" min="0" />
                                <span asp-validation-for="EmployeesNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer text-left">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save ml-1"></i> حفظ التغييرات
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('LogoFile')?.addEventListener('change', function (event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (loadEvent) {
                document.getElementById('companyLogoPreview').src = loadEvent.target.result;
            };
            reader.readAsDataURL(file);

            const label = event.target.nextElementSibling;
            if (label) label.textContent = file.name;
        });
    </script>
}
