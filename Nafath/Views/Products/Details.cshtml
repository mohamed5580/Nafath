@model Domin.Entity.Product
@using Domin.Entity
@using Domin.Resource
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = Model.Name;
    var related = ViewBag.RelatedProducts as IEnumerable<Product> ?? Enumerable.Empty<Product>();
    var allImages = new List<string>();
    if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        allImages.Add(Model.ImageUrl);
    }
    if (Model.Images != null && Model.Images.Any())
    {
        allImages.AddRange(Model.Images.OrderBy(i => i.DisplayOrder).Select(i => i.ImageUrl));
    }
    if (!allImages.Any())
    {
        allImages.Add("/images/default.png");
    }
}

<partial name="_Notifications" />

<div class="container py-5" lang="ar" dir="rtl">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-light p-3 rounded-3">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
            <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">المتجر</a></li>
            @if (Model.ProductType != null)
            {
                <li class="breadcrumb-item">
                    <a asp-controller="Products" asp-action="Index" asp-route-ProductTypeId="@Model.ProductTypeId">
                        @Model.ProductType.Name
                    </a>
                </li>
            }
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Main Product Card -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
        <div class="card-body p-4 p-lg-5">
            <div class="row g-5">
                <!-- Gallery Column -->
                <div class="col-lg-6">
                    <div class="product-gallery">
                        <div class="main-image-container position-relative mb-3 bg-light rounded-4 overflow-hidden text-center p-3" style="min-height: 400px; display: flex; align-items: center; justify-content: center;">
                            @if (Model.IsOnSale)
                            {
                                var discount = Math.Round((1 - (Model.Price!.Value / Model.OldPrice!.Value)) * 100);
                                <span class="badge bg-danger position-absolute top-0 end-0 m-3 fs-6 px-3 py-2 rounded-pill shadow-sm">
                                    خصم @discount%
                                </span>
                            }
                            <img id="mainProductImage" src="@allImages.First()" alt="@Model.Name"
                                 class="img-fluid rounded-3" style="max-height: 420px; object-fit: contain; transition: transform 0.3s ease;" />
                        </div>

                        <!-- Thumbnails -->
                        @if (allImages.Count > 1)
                        {
                            <div class="d-flex gap-2 overflow-auto py-2">
                                @for (int i = 0; i < allImages.Count; i++)
                                {
                                    var img = allImages[i];
                                    <div class="gallery-thumb border rounded-3 p-1 cursor-pointer @(i == 0 ? "border-primary" : "")"
                                         style="width: 75px; height: 75px; cursor: pointer; flex-shrink: 0;"
                                         onclick="switchMainImage('@img', this)">
                                        <img src="@img" alt="Thumbnail" class="w-100 h-100 rounded-2" style="object-fit: cover;" />
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Product Details Column -->
                <div class="col-lg-6 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-light text-primary border border-primary px-3 py-2 rounded-pill">
                                @(Model.ProductType?.Name ?? "عام")
                            </span>
                            @if (!string.IsNullOrEmpty(Model.SKU))
                            {
                                <small class="text-muted font-monospace">كود المنتج: @Model.SKU</small>
                            }
                        </div>

                        <h1 class="h2 fw-bold text-dark mb-3">@Model.Name</h1>

                        <!-- Price Section -->
                        <div class="d-flex align-items-baseline gap-3 mb-4">
                            <span class="h2 text-primary fw-bold mb-0">@Model.Price EGP</span>
                            @if (Model.IsOnSale)
                            {
                                <span class="h4 text-muted text-decoration-line-through mb-0">@Model.OldPrice EGP</span>
                            }
                        </div>

                        <!-- Stock Status -->
                        <div class="mb-4">
                            @if (Model.IsInStock)
                            {
                                @if (Model.StockQuantity <= Model.LowStockThreshold)
                                {
                                    <div class="btn btn-primary py-2 px-3 d-inline-flex align-items-center rounded-pill mb-0">
                                        <i class="bi bi-exclamation-triangle-fill me-2 ms-2 text-warning"></i>
                                        <span>سارع بالطلب! متبقي فقط <strong>@Model.StockQuantity</strong> قطع في المخزن</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="btn btn-primary py-2 px-3 d-inline-flex align-items-center rounded-pill mb-0 white">
                                        <i class="bi bi-cart-plus fs-5 "></i>
                                        <span >متوفر في المخزن (@Model.StockQuantity قطعة)</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-danger py-2 px-3 d-inline-flex align-items-center rounded-pill mb-0">
                                    <i class="bi bi-x-circle-fill me-2 ms-2 text-danger"></i>
                                    <span>نفذت الكمية حالياً</span>
                                </div>
                            }
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <h5 class="fw-bold mb-2">الوصف:</h5>
                            <p class="text-muted leading-relaxed" style="line-height: 1.8;">
                                @Model.Description
                            </p>
                        </div>
                    </div>

                    <!-- Purchase Actions -->
                    <div class="border-top pt-4 mt-auto">
                        @if (Model.IsInStock)
                        {
                            @if (Model.Colors != null && Model.Colors.Any())
                            {
                                <div class="color-picker mb-4" id="colorPicker">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <span class="fw-bold">اللون:</span>
                                            <span id="selectedColorLabel" class="text-primary fw-semibold ms-1"></span>
                                        </div>
                                        <span class="small text-muted font-monospace" id="selectedColorHexCode"></span>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2 align-items-center" id="colorOptions" role="group" aria-label="اختيار اللون">
                                        @foreach (var color in Model.Colors.OrderBy(c => c.DisplayOrder))
                                        {
                                            <button type="button"
                                                    class="color-swatch-chip"
                                                    data-color-id="@color.Id"
                                                    data-color-name="@color.ColorName"
                                                    data-color-hex="@color.HexCode"
                                                    title="@color.ColorName (@color.HexCode)"
                                                    aria-label="@color.ColorName">
                                                <span class="swatch-circle" style="background-color: @color.HexCode;"></span>
                                                <i class="bi bi-check check-icon"></i>
                                            </button>
                                        }
                                    </div>
                                    <small id="colorValidation" class="text-danger d-none mt-2">يرجى اختيار اللون أولاً.</small>
                                </div>
                            }

                            @if (Model.Sizes.Any())
                            {
                                <div class="size-picker mb-4" id="sizePicker">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <span class="fw-bold">المقاس</span>
                                            <span id="selectedSizeLabel" class="text-muted"></span>
                                        </div>
                                        <button type="button" class="btn btn-link p-0 text-decoration-underline size-guide-link" data-bs-toggle="modal" data-bs-target="#sizeGuideModal">
                                            دليل المقاسات
                                        </button>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2" id="sizeOptions" role="group" aria-label="اختيار المقاس">
                                        @foreach (var size in Model.Sizes)
                                        {
                                            <button type="button" class="size-chip" data-size="@size">@size</button>
                                        }
                                    </div>
                                    <small id="sizeValidation" class="text-danger d-none mt-2">يرجى اختيار المقاس أولاً.</small>
                                </div>
                            }
                            <div class="row g-3 align-items-center">
                                <div class="col-auto">
                                    <label class="form-label small text-muted d-block mb-1">الكمية:</label>
                                    <div class="input-group input-group-lg" style=""dir="ltr">
                                        <button class="btn btn-outline-secondary" type="button" onclick="adjustQty(-1)">-</button>
                                        <input type="number" id="detailQty" class="form-control text-center fw-bold"
                                               value="1" min="1" max="@Model.StockQuantity" readonly />
                                        <button class="btn btn-outline-secondary" type="button" onclick="adjustQty(1)">+</button>
                                    </div>
                                </div>
                                <div class="col">
                                    <label class="form-label d-block mb-1">&nbsp;</label>
                                    <button type="button"
                                            id="btnAddToCart"
                                            data-id="@Model.Id"
                                            data-name="@Model.Name"
                                            data-price="@Model.Price"
                                            data-imageurl="@(allImages.First())"
                                            data-color-name="@Model.Colors"
                                            class="btn btn-primary btn-lg w-100 d-flex align-items-center justify-content-center gap-2 shadow add-to-cart-mobile-text">
                                        <i class="bi bi-cart-plus fs-5"></i>
                                        <span class="add-to-cart-mobile-text">أضف إلى السلة</span>
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-lg w-100 disabled" disabled>
                                غير متاح للطلب الآن
                            </button>
                        }

                        <!-- Assurance Badges -->
                        <div class="row text-center mt-4 pt-3 border-top g-2">
                            <div class="col-4">
                                <i class="bi bi-truck text-primary fs-4 d-block mb-1"></i>
                                <small class="text-muted fw-semibold">شحن سريع</small>
                            </div>
                            <div class="col-4">
                                <i class="bi bi-shield-check text-primary fs-4 d-block mb-1"></i>
                                <small class="text-muted fw-semibold">ضمان الجودة</small>
                            </div>
                            <div class="col-4">
                                <i class="bi bi-arrow-repeat text-primary fs-4 d-block mb-1"></i>
                                <small class="text-muted fw-semibold">إمكانية الاسترجاع</small>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (related.Any())
    {
        <div class="mt-5">
            <h3 class="fw-bold mb-4">منتجات مشابهة</h3>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
                @foreach (var item in related)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card">
                            <div class="position-relative bg-light text-center p-3">
                                @if (item.IsOnSale)
                                {
                                    <span class="badge bg-danger position-absolute top-0 end-0 m-2 rounded-pill">خصم</span>
                                }
                                <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name"
                                     style="height: 180px; object-fit: contain;">
                            </div>
                            <div class="card-body d-flex flex-column p-3">
                                <h6 class="card-title fw-bold text-truncate mb-2">@item.Name</h6>
                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <span class="text-primary fw-bold">@item.Price EGP</span>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        عرض التفاصيل
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (Model.Sizes.Any())
{
    <div class="modal fade" id="sizeGuideModal" tabindex="-1" aria-labelledby="sizeGuideTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="sizeGuideTitle">دليل المقاسات</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-3">قياسات الجسم بالسنتيمتر. قيسي محيط الصدر والخصر والورك ثم اختاري أقرب مقاس.</p>
                    <div class="table-responsive">
                        <table class="table table-bordered text-center align-middle mb-3">
                            <thead class="table-light">
                                <tr>
                                    <th>المقاس</th>
                                    <th>الصدر</th>
                                    <th>الخصر</th>
                                    <th>الورك</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in new (string Size, string Bust, string Waist, string Hip)[]
                                {
                                    ("XXS", "74–78", "58–62", "80–84"),
                                    ("XS", "78–82", "62–66", "84–88"),
                                    ("S", "82–86", "66–70", "88–92"),
                                    ("M", "86–90", "70–74", "92–96"),
                                    ("L", "90–96", "74–80", "96–102")
                                })
                                {
                                    if (!Model.Sizes.Contains(row.Size))
                                    {
                                        continue;
                                    }
                                    <tr>
                                        <td class="fw-bold">@row.Size</td>
                                        <td>@row.Bust</td>
                                        <td>@row.Waist</td>
                                        <td>@row.Hip</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <ul class="small text-muted mb-0">
                        <li>الصدر: حول أكمل جزء من الصدر.</li>
                        <li>الخصر: حول أضيق جزء من الخصر.</li>
                        <li>الورك: حول أكمل جزء من الورك.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <style>
        /* Color Swatches */
        .color-swatch-chip {
            position: relative;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: 2px solid #e0e0e0;
            padding: 3px;
            background: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
            outline: none;
        }
        .color-swatch-chip .swatch-circle {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            display: block;
            border: 1px solid rgba(0, 0, 0, 0.15);
            box-shadow: inset 0 1px 2px rgba(0,0,0,0.1);
        }
        .color-swatch-chip:hover {
            transform: scale(1.15);
            border-color: #333;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
        }
        .color-swatch-chip.active {
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.35);
            transform: scale(1.12);
        }
        .color-swatch-chip .check-icon {
            display: none;
            position: absolute;
            font-size: 1.1rem;
            color: #fff;
            text-shadow: 0 1px 3px rgba(0,0,0,0.8), 0 0 2px #000;
        }
        .color-swatch-chip.active .check-icon {
            display: inline-block;
        }
        .color-picker.is-invalid .color-swatch-chip {
            border-color: #dc3545;
        }

        .size-chip {
            min-width: 72px;
            height: 40px;
            padding: 0 14px;
            border: 1px solid #c7c7c7;
            background: #fff;
            color: #222;
            font-weight: 600;
            letter-spacing: 0.04em;
        }
        .size-chip:hover {
            border-color: #222;
        }
        .size-chip.active {
            border: 2px solid #111;
            color: #111;
        }
        .size-picker.is-invalid .size-chip {
            border-color: #dc3545;
        }
        .size-guide-link {
            color: #222;
            font-size: 0.95rem;
        }
        .add-to-cart-mobile-text {
            font-size: 0.8rem;
        }

        @@media (min-width: 992px) {
            .add-to-cart-mobile-text {
                font-size: 1.1rem;
            }
        }
    </style>
    <script>
        function switchMainImage(url, el) {
            const mainImg = document.getElementById('mainProductImage');
            mainImg.style.opacity = '0.3';
            setTimeout(() => {
                mainImg.src = url;
                mainImg.style.opacity = '1';
            }, 150);

            document.querySelectorAll('.gallery-thumb').forEach(t => t.classList.remove('border-primary'));
            el.classList.add('border-primary');
        }

        const maxQty = @Model.StockQuantity;
        let selectedSize = null;
        let selectedColor = null;

        // Color Swatches interaction
        const colorLabel = document.getElementById('selectedColorLabel');
        const colorHex = document.getElementById('selectedColorHexCode');

        document.querySelectorAll('.color-swatch-chip').forEach(chip => {
            chip.addEventListener('mouseenter', function () {
                if (colorLabel) {
                    colorLabel.textContent = this.dataset.colorName;
                }
                if (colorHex) {
                    colorHex.textContent = this.dataset.colorHex;
                }
            });

            chip.addEventListener('mouseleave', function () {
                if (selectedColor) {
                    if (colorLabel) colorLabel.textContent = selectedColor.name;
                    if (colorHex) colorHex.textContent = selectedColor.hex;
                } else {
                    if (colorLabel) colorLabel.textContent = '';
                    if (colorHex) colorHex.textContent = '';
                }
            });

            chip.addEventListener('click', function () {
                selectedColor = {
                    id: this.dataset.colorId,
                    name: this.dataset.colorName,
                    hex: this.dataset.colorHex
                };
                document.querySelectorAll('.color-swatch-chip').forEach(c => c.classList.remove('active'));
                this.classList.add('active');

                if (colorLabel) colorLabel.textContent = selectedColor.name;
                if (colorHex) colorHex.textContent = selectedColor.hex;

                document.getElementById('colorPicker')?.classList.remove('is-invalid');
                document.getElementById('colorValidation')?.classList.add('d-none');
            });
        });

        document.querySelectorAll('.size-chip').forEach(button => {
            button.addEventListener('click', function () {
                selectedSize = this.dataset.size;
                document.querySelectorAll('.size-chip').forEach(item => item.classList.remove('active'));
                this.classList.add('active');
                const label = document.getElementById('selectedSizeLabel');
                if (label) label.textContent = ': ' + selectedSize;
                document.getElementById('sizePicker')?.classList.remove('is-invalid');
                document.getElementById('sizeValidation')?.classList.add('d-none');
            });
        });

        function adjustQty(delta) {
            const input = document.getElementById('detailQty');
            let current = parseInt(input.value) || 1;
            let next = current + delta;
            if (next < 1) next = 1;
            if (next > maxQty) next = maxQty;
            input.value = next;
        }

        document.getElementById('btnAddToCart')?.addEventListener('click', function () {
            const btn = this;
            const id = parseInt(btn.dataset.id);
            const name = btn.dataset.name;
            const price = parseFloat(btn.dataset.price);
            const imageUrl = btn.dataset.imageurl;
            const count = parseInt(document.getElementById('detailQty').value) || 1;

            if (document.querySelectorAll('.color-swatch-chip').length > 0 && !selectedColor) {
                document.getElementById('colorPicker')?.classList.add('is-invalid');
                document.getElementById('colorValidation')?.classList.remove('d-none');
                document.getElementById('colorPicker')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            if (document.querySelectorAll('.size-chip').length > 0 && !selectedSize) {
                document.getElementById('sizePicker')?.classList.add('is-invalid');
                document.getElementById('sizeValidation')?.classList.remove('d-none');
                document.getElementById('sizePicker')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            if (typeof shoppingCart !== 'undefined') {
                for (let i = 0; i < count; i++) {
                    shoppingCart.addItemToCart(
                        id,
                        name,
                        price,
                        count,
                        imageUrl,
                        selectedSize,
                        selectedColor ? selectedColor.name : null,
                        selectedColor ? selectedColor.hex : null
                    );
                }
                updateCartDisplay();

                let itemVariantDetails = [];
                if (selectedColor) itemVariantDetails.push(`اللون: ${selectedColor.name}`);
                if (selectedSize) itemVariantDetails.push(`المقاس: ${selectedSize}`);
                const variantText = itemVariantDetails.length > 0 ? ` (${itemVariantDetails.join('، ')})` : '';

                Swal.fire({
                    icon: 'success',
                    title: 'تمت الإضافة!',
                    text: `تم إضافة (${count}) من ${name}${variantText} إلى سلة مشترياتك.`,
                    timer: 2000,
                    showConfirmButton: false
                });
            }
        });
    </script>
}
