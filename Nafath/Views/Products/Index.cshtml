@model Infrastructure.ViewModel.ProductFilterVm
@using Domin.Entity
@using Domin.Resource
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "المتجر - نفاذ";
}

<partial name="_Notifications" />

<div class="container py-4" lang="ar" dir="rtl">
    <!-- Hero / Store Header -->
    <div class="bg-primary text-white rounded-4 p-4 p-lg-5 mb-4 shadow-sm position-relative overflow-hidden"
         style="background: linear-gradient(135deg, #1d3557 0%, #457b9d 100%);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-white text-primary mb-2 px-3 py-2 rounded-pill fw-bold">تسوق أفضل الأثاث المكتبي</span>
                <h1 class="display-6 fw-bold mb-2">متجر نفاذ</h1>
                <p class="lead mb-0 text-white-50">اكتشف تشكيلتنا الواسعة من الكراسي والمكاتب والحلول المكتبية المتكاملة بأعلى جودة وضمان.</p>
            </div>
            <div class="col-lg-4 text-lg-start text-center mt-3 mt-lg-0">
                <button class="btn btn-light btn-lg px-4 rounded-pill shadow-sm text-primary fw-bold"
                        data-bs-toggle="modal"
                        data-bs-target="#cartModal">
                    <i class="bi bi-cart3 me-1"></i> سلة المشتريات
                </button>
            </div>
        </div>
    </div>

    <!-- Store Layout (Sidebar Filters + Products Grid) -->
    <div class="row g-4">
        <!-- Sidebar Filters -->
        <aside class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 90px;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0"><i class="bi bi-funnel me-1"></i> تصفية المنتجات</h5>
                        <a asp-action="Index" class="small text-danger text-decoration-none">إعادة ضبط</a>
                    </div>

                    <form method="get" asp-action="Index" id="filterForm">
                        <!-- Search Box -->
                        <div class="mb-4">
                            <label class="form-label small fw-semibold text-muted">بحث بالاسم أو الكود</label>
                            <div class="input-group">
                                <input type="text" name="SearchTerm" value="@Model.SearchTerm"
                                       class="form-control" placeholder="ابحث هنا..." />
                                <button class="btn btn-primary" type="submit">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Categories -->
                        <div class="mb-4">
                            <label class="form-label small fw-semibold text-muted">التصنيفات</label>
                            <div class="list-group list-group-flush rounded-3 border">
                                <a asp-action="Index"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-SortBy="@Model.SortBy"
                                   asp-route-MinPrice="@Model.MinPrice"
                                   asp-route-MaxPrice="@Model.MaxPrice"
                                   asp-route-InStockOnly="@Model.InStockOnly"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(Model.ProductTypeId == null ? "active" : "")">
                                    <span>الكل</span>
                                </a>
                                @foreach (var cat in Model.Categories)
                                {
                                    <a asp-action="Index"
                                       asp-route-ProductTypeId="@cat.Id"
                                       asp-route-SearchTerm="@Model.SearchTerm"
                                       asp-route-SortBy="@Model.SortBy"
                                       asp-route-MinPrice="@Model.MinPrice"
                                       asp-route-MaxPrice="@Model.MaxPrice"
                                       asp-route-InStockOnly="@Model.InStockOnly"
                                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(Model.ProductTypeId == cat.Id ? "active" : "")">
                                        <span>@cat.Name</span>
                                    </a>
                                }
                            </div>
                            @if (Model.ProductTypeId.HasValue)
                            {
                                <input type="hidden" name="ProductTypeId" value="@Model.ProductTypeId" />
                            }
                        </div>

                        <!-- Price Range -->
                        <div class="mb-4">
                            <label class="form-label small fw-semibold text-muted">نطاق السعر (EGP)</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="number" name="MinPrice" value="@Model.MinPrice"
                                           class="form-control form-control-sm" placeholder="من (@Model.PriceFloor)" min="0" />
                                </div>
                                <div class="col-6">
                                    <input type="number" name="MaxPrice" value="@Model.MaxPrice"
                                           class="form-control form-control-sm" placeholder="إلى (@Model.PriceCeiling)" min="0" />
                                </div>
                            </div>
                        </div>

                        <!-- In Stock Only -->
                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input" type="checkbox" name="InStockOnly" value="true"
                                   id="inStockCheck" @(Model.InStockOnly ? "checked" : "") onchange="this.form.submit()" />
                            <label class="form-check-label small fw-semibold" for="inStockCheck">
                                المنتجات المتوفرة فقط
                            </label>
                        </div>

                        <!-- Hidden Sort By tracker -->
                        <input type="hidden" name="SortBy" value="@Model.SortBy" />

                        <button type="submit" class="btn btn-primary w-100 rounded-pill">
                            تطبيق التصفية
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="col-lg-9">
            <!-- Top Controls (Count + Sort) -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="text-muted small">
                        عرض <strong class="text-dark">@Model.Products.Count</strong> من إجمالي <strong class="text-dark">@Model.TotalItems</strong> منتج
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <span> لنتائج البحث عن "<em>@Model.SearchTerm</em>"</span>
                        }
                    </div>

                    <!-- Sort Dropdown -->
                    <div class="d-flex align-items-center gap-2">
                        <label class="small text-muted text-nowrap mb-0">ترتيب حسب:</label>
                        <select class="form-select form-select-sm rounded-pill" style="min-width: 170px;"
                                onchange="location = this.value;">
                            <option value="@Url.Action("Index", new { SearchTerm = Model.SearchTerm, ProductTypeId = Model.ProductTypeId, MinPrice = Model.MinPrice, MaxPrice = Model.MaxPrice, InStockOnly = Model.InStockOnly, SortBy = "newest" })"
                                    selected="@(Model.SortBy == "newest")">الأحدث أولاً</option>
                            <option value="@Url.Action("Index", new { SearchTerm = Model.SearchTerm, ProductTypeId = Model.ProductTypeId, MinPrice = Model.MinPrice, MaxPrice = Model.MaxPrice, InStockOnly = Model.InStockOnly, SortBy = "price_asc" })"
                                    selected="@(Model.SortBy == "price_asc")">السعر: من الأقل للأعلى</option>
                            <option value="@Url.Action("Index", new { SearchTerm = Model.SearchTerm, ProductTypeId = Model.ProductTypeId, MinPrice = Model.MinPrice, MaxPrice = Model.MaxPrice, InStockOnly = Model.InStockOnly, SortBy = "price_desc" })"
                                    selected="@(Model.SortBy == "price_desc")">السعر: من الأعلى للأقل</option>
                            <option value="@Url.Action("Index", new { SearchTerm = Model.SearchTerm, ProductTypeId = Model.ProductTypeId, MinPrice = Model.MinPrice, MaxPrice = Model.MaxPrice, InStockOnly = Model.InStockOnly, SortBy = "name_asc" })"
                                    selected="@(Model.SortBy == "name_asc")">الاسم: أ - ي</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Products Grid -->
            @if (Model.Products.Any())
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                    @foreach (var product in Model.Products)
                    {
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card transition-all"
                                 style="transition: transform 0.2s ease, box-shadow 0.2s ease;">
                                <!-- Image Container -->
                                <div class="position-relative bg-light text-center p-3" style="min-height: 220px; display: flex; align-items: center; justify-content: center;">
                                    @if (product.IsOnSale)
                                    {
                                        var discount = Math.Round((1 - (product.Price!.Value / product.OldPrice!.Value)) * 100);
                                        <span class="badge bg-danger position-absolute top-0 end-0 m-3 px-2 py-1 rounded-pill small">
                                            خصم @discount%
                                        </span>
                                    }

                                    @if (!product.IsInStock)
                                    {
                                        <span class="badge bg-secondary position-absolute top-0 start-0 m-3 px-2 py-1 rounded-pill small">
                                            نفذت الكمية
                                        </span>
                                    }
                                    else if (product.StockQuantity <= product.LowStockThreshold)
                                    {
                                        <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-3 px-2 py-1 rounded-pill small">
                                            متبقي @product.StockQuantity فقط
                                        </span>
                                    }

                                    <a asp-action="Details" asp-route-id="@product.Id" class="d-block w-100">
                                        <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/default.png" : product.ImageUrl)"
                                             class="img-fluid" alt="@product.Name"
                                             style="max-height: 190px; object-fit: contain;">
                                    </a>
                                </div>

                                <!-- Card Body -->
                                <div class="card-body d-flex flex-column p-4">
                                    <div class="mb-1">
                                        <small class="text-muted">@(product.ProductType?.Name ?? "عام")</small>
                                    </div>
                                    <h5 class="card-title fw-bold mb-2">
                                        <a asp-action="Details" asp-route-id="@product.Id" class="text-dark text-decoration-none">
                                            @product.Name
                                        </a>
                                    </h5>
                                    <p class="text-muted small text-truncate-2 mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 40px;">
                                        @product.Description
                                    </p>

                                    <!-- Price & Cart Action -->
                                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="h5 fw-bold text-primary mb-0">@product.Price EGP</span>
                                            @if (product.IsOnSale)
                                            {
                                                <div class="small text-muted text-decoration-line-through">@product.OldPrice EGP</div>
                                            }
                                        </div>

                                        @if (product.IsInStock)
                                        {
                                            <button type="button"
                                                    class="btn btn-primary rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm btn-quick-cart"
                                                    style="width: 42px; height: 42px;"
                                                    data-id="@product.Id"
                                                    data-name="@product.Name"
                                                    data-price="@product.Price"
                                                    data-imageurl="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/default.png" : product.ImageUrl)"
                                                    title="أضف إلى السلة">
                                                <i class="bi bi-cart-plus fs-5"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border px-2 py-1">غير متاح</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Modern Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-5" aria-label="Store pagination">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                <a class="page-link rounded-start-pill px-3"
                                   asp-action="Index"
                                   asp-route-Page="@(Model.Page - 1)"
                                   asp-route-PageSize="@Model.PageSize"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-ProductTypeId="@Model.ProductTypeId"
                                   asp-route-MinPrice="@Model.MinPrice"
                                   asp-route-MaxPrice="@Model.MaxPrice"
                                   asp-route-InStockOnly="@Model.InStockOnly"
                                   asp-route-SortBy="@Model.SortBy">السابق</a>
                            </li>

                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.Page ? "active" : "")">
                                    <a class="page-link px-3"
                                       asp-action="Index"
                                       asp-route-Page="@p"
                                       asp-route-PageSize="@Model.PageSize"
                                       asp-route-SearchTerm="@Model.SearchTerm"
                                       asp-route-ProductTypeId="@Model.ProductTypeId"
                                       asp-route-MinPrice="@Model.MinPrice"
                                       asp-route-MaxPrice="@Model.MaxPrice"
                                       asp-route-InStockOnly="@Model.InStockOnly"
                                       asp-route-SortBy="@Model.SortBy">@p</a>
                                </li>
                            }

                            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link rounded-end-pill px-3"
                                   asp-action="Index"
                                   asp-route-Page="@(Model.Page + 1)"
                                   asp-route-PageSize="@Model.PageSize"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-ProductTypeId="@Model.ProductTypeId"
                                   asp-route-MinPrice="@Model.MinPrice"
                                   asp-route-MaxPrice="@Model.MaxPrice"
                                   asp-route-InStockOnly="@Model.InStockOnly"
                                   asp-route-SortBy="@Model.SortBy">التالي</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <!-- Empty State -->
                <div class="card border-0 shadow-sm rounded-4 text-center py-5">
                    <div class="card-body">
                        <i class="bi bi-search text-muted" style="font-size: 3rem;"></i>
                        <h4 class="fw-bold mt-3">لم يتم العثور على منتجات</h4>
                        <p class="text-muted">جرب البحث بكلمات أخرى أو قم بإلغاء التصفية لإظهار كافة المنتجات.</p>
                        <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                            عرض جميع المنتجات
                        </a>
                    </div>
                </div>
            }
        </main>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-quick-cart').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const id = parseInt(this.dataset.id);
                const name = this.dataset.name;
                const price = parseFloat(this.dataset.price);
                const imageUrl = this.dataset.imageurl;

                if (typeof shoppingCart !== 'undefined') {
                    shoppingCart.addItemToCart(id, name, price, 1, imageUrl);
                    updateCartDisplay();
                    Swal.fire({
                        icon: 'success',
                        title: 'تمت الإضافة!',
                        text: `تم إضافة ${name} إلى سلة المشتريات.`,
                        timer: 1800,
                        showConfirmButton: false
                    });
                }
            });
        });
    </script>
}
