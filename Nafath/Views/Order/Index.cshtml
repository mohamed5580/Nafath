@model IEnumerable<OrderDetailsViewModel>
@{
    ViewData["Title"] = "قائمة الطلبات";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
}

<div class="wrapper container">
    <!-- Content Header -->
    <div class="content-header mb-4">
        <div class="row">
            <div class="col-sm-6">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">إدارة الطلبات</li>
                    <li class="breadcrumb-item active">
                        <a href="/">الصفحة الرئيسية</a>
                    </li>
                </ol>
            </div>
            <div class="col-sm-6 ">
                <h1 class="m-0">قائمة الطلبات</h1>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <section class="content">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">الطلبات</h4>
                <h6 class="card-title">سيتم التواصل معكم في أقرب وقت</h6>
            </div>
            <div class="card-body">
                @Html.AntiForgeryToken()

                @if (Model == null || !Model.Any())
                {
                    <div class="alert alert-info">لا توجد طلبات متاحة</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover text-center text-nowrap">
                            <thead>
                                <tr>
                                    <th>رقم الطلب</th>
                                    <th>تاريخ الطلب</th>
                                    <th>حالة الطلب</th>
                                    <th>تفاصيل الطلب</th>
                                    <th>تعديل الطلب</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var vm in Model)
                                {
                                    <tr>
                                        <td>#@vm.Order.Id</td>
                                        <td>@vm.Order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@vm.Order.OrderStatus</td>
                                        <td>
                                            <button class="btn bg-gradient-success text-white btn-view-order"
                                                    data-order-id="@vm.Order.Id">
                                                عرض التفاصيل
                                            </button>
                                        </td>
                                        <td>
                                            <button class="btn btn-warning btn-edit-order"
                                                    data-order-id="@vm.Order.Id">
                                                تعديل الطلب
                                            </button>
                                        </td>
                                        <td>
                                            <button class="btn btn-link text-danger remove-order"
                                                    data-order-id="@vm.Order.Id">
                                                &times;
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    <nav>
                        <ul class="pagination justify-content-center">
                            @{
                                var prev = currentPage > 1 ? currentPage - 1 : 1;
                                var next = currentPage < totalPages ? currentPage + 1 : totalPages;
                            }
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = prev })">السابق</a>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = next })">التالي</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </section>
</div>

<!-- ========== مودال عرض التفاصيل ========== -->
<div class="modal fade" id="viewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewModalTitle">تفاصيل الطلب</h5>
                <button type="button" class="btn-close ml-0" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="viewModalBody">
                <!-- سيتم ملؤها عبر JavaScript -->
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

<!-- ========== مودال تعديل الطلب ========== -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title ms-auto" id="editModalTitle">تعديل الطلب</h5>
                <button type="button" class="btn-close ml-0" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive table-scroll-wrapper">
                    <table class="table table-bordered table-hover text-center text-nowrap">
                        <thead class="thead-light">
                            <tr>
                                <th>المنتج</th>
                                <th>المقاس</th>
                                <th>اللون</th>
                                <th>السعر</th>
                                <th>الكمية</th>
                                <th>السعر الكلي</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="editCartBody">
                        </tbody>
                    </table>
                </div>                <div class="d-flex justify-content-end mt-3">
                    <h5>المبلغ الكلي: <span id="totalCarts">0.00</span> EGP</h5>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-danger clear-carts">تفريغ السلة</button>
                <form id="editForm" asp-controller="Order" asp-action="UpdateOrder" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" id="editOrderId" value="" />
                    <input type="hidden" name="itemsJson" id="editItemsJson" value="" />
                    <button type="button" class="btn btn-primary btn-save-edit">حفظ التعديلات</button>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(function () {

            // ========== دوال مساعدة ==========
            function escapeHtml(value) {
                return String(value ?? '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            // ========== إدارة السلة المؤقتة ==========
            const editCart = {
                items: [],
                orderId: null,

                // مفتاح مميز لكل منتج + مقاس + لون + كود اللون
                itemKey: function (item) {
                    return [
                        item.productId,
                        item.size || '',
                        item.color || '',
                        item.colorCode || ''
                    ].join(':');
                },

                // تحميل المنتجات من السيرفر
                loadItems: function (orderId) {
                    var self = this;
                    self.orderId = orderId;
                    self.items = [];

                    $('#editCartBody').html(
                        '<tr><td colspan="7" class="text-center">' +
                        '<i class="bi bi-arrow-repeat nafas-spin"></i> جاري تحميل المنتجات...</td></tr>'
                    );

                    $.getJSON('/Order/GetOrderItems', { orderId: orderId })
                        .done(function (data) {
                            self.items = data.map(function (item) {
                                return {
                                    productId: item.productId,
                                    name: item.name,
                                    price: Number(item.price) || 0,
                                    count: Number(item.count) || 0,
                                    imageUrl: item.imageUrl,
                                    size: item.size || null,
                                    color: item.color || null,
                                    colorCode: item.colorCode || null
                                };
                            });

                            self.render();
                        })
                        .fail(function () {
                            $('#editCartBody').html(
                                '<tr><td colspan="7" class="text-danger text-center">' +
                                'حدث خطأ أثناء تحميل المنتجات</td></tr>'
                            );
                        });
                },

                // تغيير الكمية
                setCount: function (key, newCount) {
                    var item = this.items.find(i => this.itemKey(i) === key);

                    if (item) {
                        if (newCount > 0) {
                            item.count = newCount;
                        } else {
                            this.removeItem(key);
                            return;
                        }

                        this.render();
                    }
                },

                // زيادة الكمية
                increment: function (key) {
                    var item = this.items.find(i => this.itemKey(i) === key);

                    if (item) {
                        item.count++;
                        this.render();
                    }
                },

                // تقليل الكمية
                decrement: function (key) {
                    var item = this.items.find(i => this.itemKey(i) === key);

                    if (item && item.count > 1) {
                        item.count--;
                        this.render();
                    }
                },

                // حذف عنصر
                removeItem: function (key) {
                    this.items = this.items.filter(i => this.itemKey(i) !== key);
                    this.render();
                },

                // تفريغ الطلب
                clear: function () {
                    this.items = [];
                    this.render();
                },

                // حفظ التعديلات
                save: function () {
                    var itemsJson = JSON.stringify(this.items.map(function (item) {
                        return {
                            productId: item.productId,
                            quantity: item.count,
                            unitPrice: item.price,
                            size: item.size,
                            color: item.color,
                            colorCode: item.colorCode
                        };
                    }));

                    $('#editOrderId').val(this.orderId);
                    $('#editItemsJson').val(itemsJson);

                    // إرسال الفورم
                    $('#editForm')[0].submit();
                },

                // عرض المنتجات
                render: function () {
                    var tbody = $('#editCartBody');
                    var totalSpan = $('#totalCarts');

                    if (this.items.length === 0) {
                        tbody.html(
                            '<tr><td colspan="7" class="text-center text-muted">' +
                            'سلة المشتريات فارغة</td></tr>'
                        );

                        totalSpan.text('0.00');
                        return;
                    }

                    var total = 0;
                    var html = '';
                    var self = this;

                    this.items.forEach(function (item) {
                        var itemTotal = item.price * item.count;
                        var key = self.itemKey(item);

                        total += itemTotal;

                        var colorHtml = item.color
                            ? `<span>${escapeHtml(item.color)}</span>`
                            : '';

                        if (item.colorCode) {
                            colorHtml += `
                                <span style="
                                    display:inline-block;
                                    width:18px;
                                    height:18px;
                                    border-radius:50%;
                                    background-color:${escapeHtml(item.colorCode)};
                                    border:1px solid #ccc;
                                    vertical-align:middle;
                                    margin-right:5px;">
                                </span>
                            `;
                        }

                        html += `
                            <tr class="align-middle">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="${escapeHtml(item.imageUrl || '/default-image.png')}"
                                             alt="${escapeHtml(item.name)}"
                                             class="img-thumbnail ms-3"
                                             style="width:60px;height:60px;object-fit:cover;">

                                        <h6 class="mb-0">${escapeHtml(item.name)}</h6>
                                    </div>
                                </td>

                                <td>
                                    ${item.size
                                        ? `<small class="text-muted">${escapeHtml(item.size)}</small>`
                                        : '-'}
                                </td>

                                <td>
                                    ${colorHtml || '-'}
                                </td>

                                <td>${item.price.toFixed(2)} EGP</td>

                                <td>
                                    <div class="input-group mx-auto" style="width:140px;">
                                        <button type="button"
                                                class="btn btn-outline-secondary btn-decrement"
                                                data-key="${escapeHtml(key)}">-</button>

                                        <input type="number"
                                               min="0"
                                               class="form-control text-center edit-item-count"
                                               value="${item.count}"
                                               data-key="${escapeHtml(key)}">

                                        <button type="button"
                                                class="btn btn-outline-secondary btn-increment"
                                                data-key="${escapeHtml(key)}">+</button>
                                    </div>
                                </td>

                                <td>${itemTotal.toFixed(2)} EGP</td>

                                <td>
                                    <button type="button"
                                            class="btn btn-link text-danger btn-remove-item"
                                            data-key="${escapeHtml(key)}">
                                        &times;
                                    </button>
                                </td>
                            </tr>
                        `;
                    });

                    tbody.html(html);
                    totalSpan.text(total.toFixed(2));
                }
            };


            // ========== فتح مودال تعديل الطلب ==========
            $(document).on('click', '.btn-edit-order', function () {
                var orderId = $(this).data('order-id');

                $('#editModalTitle').text('تعديل الطلب #' + orderId);
                $('#editOrderId').val(orderId);

                editCart.loadItems(orderId);

                $('#editModal').modal('show');
            });


            // ========== زيادة الكمية ==========
            $(document).on('click', '.btn-increment', function () {
                editCart.increment(String($(this).data('key')));
            });


            // ========== تقليل الكمية ==========
            $(document).on('click', '.btn-decrement', function () {
                editCart.decrement(String($(this).data('key')));
            });


            // ========== تعديل الكمية يدويًا ==========
            $(document).on('change', '.edit-item-count', function () {
                var key = String($(this).data('key'));
                var val = parseInt($(this).val());

                if (!isNaN(val) && val >= 0) {
                    editCart.setCount(key, val);
                } else {
                    editCart.render();
                }
            });


            // ========== حذف منتج ==========
            $(document).on('click', '.btn-remove-item', function () {
                editCart.removeItem(String($(this).data('key')));
            });


            // ========== تفريغ الطلب ==========
            $(document).on('click', '.clear-carts', function (e) {
                e.preventDefault();

                Swal.fire({
                    title: 'هل تريد تفريغ الطلب بالكامل؟',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، تفريغ',
                    cancelButtonText: 'إلغاء'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        editCart.clear();
                    }
                });
            });


            // ========== حفظ التعديلات ==========
            $(document).on('click', '.btn-save-edit', function () {
                if (editCart.items.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'الطلب فارغ',
                        text: 'لا يمكن حفظ طلب بدون منتجات.'
                    });

                    return;
                }

                editCart.save();
            });


            // ========== عرض تفاصيل الطلب ==========
            $(document).on('click', '.btn-view-order', function () {
                var orderId = $(this).data('order-id');

                $('#viewModalTitle').text('تفاصيل الطلب #' + orderId);

                $('#viewModalBody').html(
                    '<div class="text-center">' +
                    '<i class="bi bi-arrow-repeat nafas-spin" style="font-size:2rem"></i>' +
                    '</div>'
                );

                $('#viewModal').modal('show');

                $.getJSON('/Order/GetOrderItems', { orderId: orderId })
                    .done(function (data) {

                        if (!data || data.length === 0) {
                            $('#viewModalBody').html(
                                '<div class="alert alert-warning">' +
                                'لا توجد بنود لهذا الطلب.</div>'
                            );
                            return;
                        }

                        var html = `
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover text-center">
                                    <thead>
                                        <tr>
                                            <th>صورة</th>
                                            <th>المنتج</th>
                                            <th>المقاس</th>
                                            <th>اللون</th>
                                            <th>الكمية</th>
                                            <th>سعر الوحدة</th>
                                            <th>الإجمالي</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;

                        data.forEach(function (item) {
                            var price = Number(item.price) || 0;
                            var count = Number(item.count) || 0;

                            var colorHtml = item.color
                                ? `<span>${escapeHtml(item.color)}</span>`
                                : '-';

                            if (item.colorCode) {
                                colorHtml += `
                                    <span style="
                                        display:inline-block;
                                        width:18px;
                                        height:18px;
                                        border-radius:50%;
                                        background-color:${escapeHtml(item.colorCode)};
                                        border:1px solid #ccc;
                                        vertical-align:middle;
                                        margin-right:5px;">
                                    </span>
                                `;
                            }

                            html += `
                                <tr>
                                    <td>
                                        <img src="${escapeHtml(item.imageUrl || '/default-image.png')}"
                                             alt="${escapeHtml(item.name)}"
                                             style="width:60px;height:60px;object-fit:cover;">
                                    </td>

                                    <td>${escapeHtml(item.name)}</td>

                                    <td>${item.size
                                        ? escapeHtml(item.size)
                                        : '-'}</td>

                                    <td>${colorHtml}</td>

                                    <td>${count}</td>

                                    <td>${price.toFixed(2)} EGP</td>

                                    <td>${(price * count).toFixed(2)} EGP</td>
                                </tr>
                            `;
                        });

                        html += `
                                    </tbody>
                                </table>
                            </div>
                        `;

                        $('#viewModalBody').html(html);
                    })
                    .fail(function () {
                        $('#viewModalBody').html(
                            '<div class="alert alert-danger">' +
                            'حدث خطأ أثناء تحميل تفاصيل الطلب</div>'
                        );
                    });
            });


            // ========== حذف الطلب ==========
            $(document).on('click', '.remove-order', function (e) {
                e.preventDefault();

                var orderId = $(this).data('order-id');

                Swal.fire({
                    title: 'هل أنت متأكد من حذف الطلب؟',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، احذف',
                    cancelButtonText: 'إلغاء'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/Order/DeleteConfirmed',
                            type: 'POST',
                            data: { id: orderId },
                            headers: {
                                'RequestVerificationToken':
                                    $('input[name="__RequestVerificationToken"]')
                                    .first().val()
                            },
                            success: function () {
                                location.reload();
                            },
                            error: function () {
                                Swal.fire(
                                    'خطأ',
                                    'حدث خطأ أثناء حذف الطلب',
                                    'error'
                                );
                            }
                        });
                    }
                });
            });


            // ========== إعادة ضبط السلة عند إغلاق المودال ==========
            $('#editModal').on('hidden.bs.modal', function () {
                editCart.items = [];
                editCart.orderId = null;
                $('#editCartBody').empty();
                $('#totalCarts').text('0.00');
            });

        });
    </script>

    @if (ViewBag.ClearShoppingCart == true)
    {
        <script>
            if (typeof shoppingCart !== 'undefined') {
                shoppingCart.clearCart();
            } else {
                localStorage.removeItem('shoppingCart');
                localStorage.removeItem('cart');
            }

            if (typeof updateCartDisplay === 'function') {
                updateCartDisplay();
            }
        </script>
    }
}
