@inject Nafath.Services.ICompanyInformationService CompanyInformationService
@{
    var company = await CompanyInformationService.GetAsync();
}

<!-- About Section -->
<section id="about" class="about section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <span>من نحن<br></span>
        <h2>@company.Name</h2>
        <p>@(string.IsNullOrWhiteSpace(company.Description) ? "نحن ملتزمون بتقديم أفضل الحلول والخدمات لعملائنا الكرام." : company.Description)</p>
    </div><!-- End Section Title -->

    <div class="container">

        <div class="row gy-4">
            <div class="col-lg-6 position-relative align-self-start" data-aos="fade-up" data-aos-delay="100">

                <div class="img-fluid img-About">
                    @if (!string.IsNullOrWhiteSpace(company.MapUrl))
                    {
                        <iframe src="@company.MapUrl" width="98%" height="316" style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    }
                    else
                    {
                        <div class="alert alert-light border text-center py-5">
                            <i class="bi bi-geo-alt fs-3 d-block mb-2"></i>
                            <strong>@company.Address</strong>
                            @if (!string.IsNullOrWhiteSpace(company.PhoneNumber))
                            {
                                <div class="mt-2"><a href="tel:@company.PhoneNumber">@company.PhoneNumber</a></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(company.Email))
                            {
                                <div><a href="mailto:@company.Email">@company.Email</a></div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-6 content" data-aos="fade-up" data-aos-delay="200">
                <h3>نحن نؤمن بالجودة والاحترافية في كل ما نقدمه.</h3>
                <p class="fst-italic">
                    فريقنا يضم نخبة من الخبراء في مجال التصميم والتطوير لتقديم أفضل النتائج.
                </p>
                <ul>
                    <li><i class="bi bi-check2-all"></i> <span>حلول مخصصة تناسب احتياجاتك.</span></li>
                    <li><i class="bi bi-check2-all"></i> <span>دعم فني متواصل على مدار الساعة.</span></li>
                    <li><i class="bi bi-check2-all"></i> <span>أسعار تنافسية وجودة عالية في جميع الخدمات.</span></li>
                </ul>
                <p>
                    نسعى دائماً لتحقيق رضا عملائنا من خلال تقديم خدمات متكاملة واحترافية.
                </p>
            </div>
        </div>

    </div>

</section><!-- /About Section -->
<!-- Stats Section -->
<section id="stats" class="stats section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4">

            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="@company.ClientsNumber" data-purecounter-duration="1" class="purecounter"></span>
                    <p>عملاء</p>
                </div>
            </div><!-- End Stats Item -->

            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="@company.ProjectsNumber" data-purecounter-duration="1" class="purecounter"></span>
                    <p>مشاريع</p>
                </div>
            </div><!-- End Stats Item -->

            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="@company.SupportHours" data-purecounter-duration="1" class="purecounter"></span>
                    <p>ساعات دعم</p>
                </div>
            </div><!-- End Stats Item -->

            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="@company.EmployeesNumber" data-purecounter-duration="1" class="purecounter"></span>
                    <p>موظفون</p>
                </div>
            </div><!-- End Stats Item -->

        </div>

    </div>

</section><!-- /Stats Section -->
