@model Infrastructure.ViewModel.HomePageViewModel
@using Domin.Entity
@using System.Collections.Generic
@using System.Text.Json

@{
    ViewData["Title"] = "الرئيسية - نفاذ";
    var products = Model.FeaturedProducts;
    var campaignGroups = products.Chunk(3).ToList();
    var swiperConfig = new
    {
        slidesPerView = 1,
        spaceBetween = 0,
        speed = 550,
        loop = campaignGroups.Count > 1,
        autoplay = campaignGroups.Count > 1
            ? (object)new { delay = 5000, disableOnInteraction = false, pauseOnMouseEnter = true }
            : false,
        navigation = new { nextEl = "#storeCampaignNext", prevEl = "#storeCampaignPrevious" },
        pagination = new { el = "#storeCampaignPagination", clickable = true }
    };
}

<partial name="_Notifications" />

<main class="store-home" lang="ar" dir="rtl">
    <div class="store-home-container">
        <section class="store-section" aria-label="عروض ومنتجات مختارة">
            <div class="store-campaign">

                <div class="store-campaign-copy">
                    <span class="store-campaign-eyebrow">
                        @(products.Count > 0 ? "اختيارات نفاذ" : "أهلاً بك في نفاذ")
                    </span>

                    <h1>
                        @(products.Count > 0
                            ? "اكتشف ما يناسبك"
                            : "اكتشف مجموعتنا")
                    </h1>

                    <p>
                        @(products.Count > 0
                            ? "تصفح أحدث المنتجات المختارة بعناية، واعثر على تفاصيل تضيف لمسة مميزة إلى يومك."
                            : "تصفح منتجاتنا واكتشف ما يناسب احتياجاتك.")
                    </p>

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="text-white store-campaign-cta ">
                        تسوق الآن
                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    </a>
                </div>

                <div class="store-campaign-products">

                    @if (products.Count > 0)
                    {
                        <div class="swiper store-campaign-swiper init-swiper">

                            <script type="application/json" class="swiper-config">
                                @Html.Raw(JsonSerializer.Serialize(swiperConfig))
                            </script>

                            <div class="swiper-wrapper">
                                @foreach (var product in products.Take(3))
                                {
                                    <div class="swiper-slide">
                                        <a asp-controller="Products"
                                           asp-action="Details"
                                           asp-route-id="@product.Id"
                                           class="store-campaign-card">

                                            <div class="store-campaign-image">
                                                <img src="@ProductImageUrl(product)"
                                                     alt="@product.Name"
                                                     loading="lazy" />
                                            </div>

                                            <span class="store-campaign-price">
                                                @product.Price?.ToString("0.##") EGP
                                            </span>

                                        </a>
                                    </div>
                                }
                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="store-campaign-empty">
                            <img src="~/Nafas/assets/images/Chair3.png"
                                 alt="اكتشف منتجات نفاذ"
                                 class="img-fluid" />

                            <div class="store-campaign-empty-content">
                                <h3>منتجاتنا في انتظارك</h3>
                                <p>اكتشف مجموعتنا المميزة من المنتجات.</p>
                            </div>
                        </div>
                    }

                </div>

                @if (products.Count > 1)
                {
                    <button id="storeCampaignPrevious"
                            class="store-campaign-control prev"
                            type="button"
                            aria-label="المنتجات السابقة">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>

                    <button id="storeCampaignNext"
                            class="store-campaign-control next"
                            type="button"
                            aria-label="المنتجات التالية">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </button>

                    <div id="storeCampaignPagination" class="store-campaign-pagination" aria-label="صفحات العروض"></div>
                }
            </div>
        </section>
        <section class="store-section" aria-labelledby="storeCategoriesTitle">
            <div class="store-section-heading">
                <div>
                    <h2 id="storeCategoriesTitle">تسوق الان</h2>
                    <p>اعثر بسرعة على ما تبحث عنه</p>
                </div>
                <a asp-controller="Products" asp-action="Index">عرض كل المنتجات <i class="bi bi-arrow-left" aria-hidden="true"></i></a>
            </div>
            <div class="store-category-track">
                @foreach (var category in Model.Categories)
                {
                    var sampleProduct = products.FirstOrDefault(product => product.ProductTypeId == category.Id);
                    <a class="store-category-card" asp-controller="Products" asp-action="Index" asp-route-ProductTypeId="@category.Id">
                        <span class="store-category-image">
                            @if (sampleProduct != null)
                            {
                                <img src="@ProductImageUrl(sampleProduct)" alt="" loading="lazy" />
                            }
                            else
                            {
                                <i class="bi bi-grid" aria-hidden="true"></i>
                            }
                        </span>
                        <span class="store-category-name">@category.Name</span>
                    </a>
                }
                @if (Model.Categories.Count == 0)
                {
                    <div class="store-empty-state">ستظهر التصنيفات هنا بعد إضافتها إلى المتجر.</div>
                }
            </div>
        </section>

        <section class="store-section" aria-labelledby="storeFeaturedTitle">
            <div class="store-section-heading">
                <div>
                    <h2 id="storeFeaturedTitle">وصل حديثاً</h2>
                    <p>أحدث المنتجات المتوفرة في المتجر</p>
                </div>
                <a asp-controller="Products" asp-action="Index" asp-route-SortBy="newest">تصفح المتجر <i class="bi bi-arrow-left" aria-hidden="true"></i></a>
            </div>
            <div class="store-featured-grid">
                @foreach (var product in products)
                {
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="store-featured-card">
                        <span class="store-featured-image">

                            @if (product.IsOnSale)
                            {
                                <span class="store-sale-badge">عرض</span>
                            }
                            <img src="@ProductImageUrl(product)" alt="@product.Name" loading="lazy" />
                        </span>
                        <span class="store-featured-info">
                            <span class="store-featured-category">@(product.ProductType?.Name ?? "منتجات نفاذ")</span>
                            <span class="store-featured-title">@product.Name</span>
                            <span class="store-featured-price">
                                @product.Price?.ToString("0.##") EGP
                                @if (product.IsOnSale)
                                {
                                    <span class="store-featured-old-price">@product.OldPrice?.ToString("0.##") EGP</span>
                                }
                            </span>
                        </span>
                    </a>
                }
                @if (products.Count == 0)
                {
                    <div class="store-empty-state">لا توجد منتجات متاحة حالياً. يرجى العودة قريباً.</div>
                }
            </div>
        </section>
    </div>
</main>

@functions {
    private string ProductImageUrl(Product product)
    {
        var imageUrl = product.Images?
            .OrderByDescending(image => image.IsPrimary)
            .ThenBy(image => image.DisplayOrder)
            .Select(image => image.ImageUrl)
            .FirstOrDefault();

        imageUrl = string.IsNullOrWhiteSpace(imageUrl) ? product.ImageUrl : imageUrl;
        return Url.Content(string.IsNullOrWhiteSpace(imageUrl) ? "~/Nafas/assets/images/Chair3.png" : imageUrl);
    }
}
