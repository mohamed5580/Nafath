@using Domin.Entity

@inject Infrastructure.IRepository.Base.IRepository<ProductType> TypeRepo
@inject Nafath.Services.ICompanyInformationService CompanyInformationService

@{
    var productTypes = await TypeRepo.FindAllasync();
    var companyInformation = await CompanyInformationService.GetAsync();
}

@inject SignInManager<ApplicationUser> SignInManager


<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#080808">
    <meta name="description" content="@companyInformation.Description">
    <meta name="author" content="@companyInformation.Name">

    <title>@ViewData["Title"] - @companyInformation.Name</title>

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="@Url.Content(string.IsNullOrWhiteSpace(companyInformation.LogoUrl) ? "~/Nafas/assets/images/logoo.png" : companyInformation.LogoUrl)">
    <link rel="stylesheet" href="~/Admin/plugins/sweetalert2/sweetalert2.min.css">
    <!-- Fonts -->
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">



    <link href="~/Nafas/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Nafas/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/Nafas/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/Nafas/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <link href="~/Nafas/assets/css/style.css" rel="stylesheet">
  
    <link href="~/Nafas/assets/css/main.css" rel="stylesheet">
    <link href="~/Nafas/assets/css/storefront.css" rel="stylesheet">
    <link href="~/Nafas/assets/css/theme.css" rel="stylesheet">
</head>

<body class="index-page">

    <header id="header" class="store-header">
    <div class="store-header-main container-fluid container-xl">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="store-brand" aria-label="@companyInformation.Name - الصفحة الرئيسية">
            <div class="logo d-flex ">
                <img src="@Url.Content(string.IsNullOrWhiteSpace(companyInformation.LogoUrl) ? "~/Nafas/assets/images/logoo.png" : companyInformation.LogoUrl)"
                     alt="@companyInformation.Name"
                     style="line-height: 1; width:50px; object-fit:contain;">
            </div>
            <span>@companyInformation.Name</span>
        </a>

        <form class="store-search" method="get" asp-area="" asp-controller="Products" asp-action="Index" role="search">
            <input type="search" name="SearchTerm" placeholder="ابحث عن المنتجات والتصنيفات" aria-label="ابحث في المتجر" />
            <button type="submit" aria-label="بحث"><i class="bi bi-search" aria-hidden="true"></i></button>
        </form>

        <div class="store-header-actions">
            <div class="dropdown">
                <button class="store-action-button dropdown-toggle" type="button" id="storeAccountMenu" data-bs-toggle="dropdown" aria-expanded="false" aria-label="حساب المستخدم">
                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                    <span class="store-action-label">حسابي</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end p-3" aria-labelledby="storeAccountMenu">
                    <partial name="_LoginPartial" />
                </ul>
            </div>
            <button class="store-action-button" type="button" data-bs-toggle="modal" data-bs-target="#cartModal" aria-label="سلة المشتريات">
                <i class="bi bi-cart3" aria-hidden="true"></i>
                <span class="store-action-label">السلة</span>
                <span class="store-cart-count" id="cart-badge">0</span>
            </button>
        </div>
    </div>

    <nav class="store-header-nav" aria-label="التنقل الرئيسي">
        <div class="store-nav-inner container-fluid container-xl">
            <details class="store-category-menu">
                <summary><i class="bi bi-grid" aria-hidden="true"></i> التصنيفات <i class="bi bi-chevron-down" aria-hidden="true"></i></summary>
                <div class="store-mega-panel">
                    <h2>تسوق حسب التصنيف</h2>
                    <div class="store-mega-grid">
                        @foreach (var type in productTypes.OrderBy(type => type.Name) )
                        {
                            <a class="store-mega-link" asp-area="" asp-controller="Products" asp-action="Index" asp-route-ProductTypeId="@type.Id">
                                <i class="bi bi-tag" aria-hidden="true"></i>
                                <span>@type.Name</span>
                            </a>
                        }
                    </div>
                </div>
            </details>
            <a asp-area="" asp-controller="Products" asp-action="Index">جميع المنتجات</a>
            @foreach (var type in productTypes.OrderBy(type => type.Name).Take(8))
            {
                <a asp-area="" asp-controller="Products" asp-action="Index" asp-route-ProductTypeId="@type.Id">@type.Name</a>
            }
            <a asp-area="" asp-controller="Products" asp-action="Index" asp-route-SortBy="newest">وصل حديثاً</a>
            <a asp-area="" asp-controller="Home" asp-action="About">عن @companyInformation.Name</a>
        </div>
    </nav>

    <div class="modal fade" id="cartModal" data-bs-backdrop="false" tabindex="-1" aria-labelledby="cartModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content ">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                    <h5 id="cartModalLabel" class="ms-auto">سلة المشتريات</h5>
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-hover text-center text-nowrap">
                            <thead class="thead-light">
                                <tr>
                                    <th>صورة المنتج</th>
                                    <th>اسم المنتج</th>
                                    <th>السعر</th>
                                    <th>الكمية</th>
                                    <th>السعر الكلي</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody class="cart-items"></tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-end mt-4">
                        <h4 class="text-secondary">المبلغ الكلي: <span class="total-cart">0.00</span> EGP</h4>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">متابعة التسوق</button>
                    <button type="button" class="btn btn-danger clear-cart">تفريغ السلة</button>
                    <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary text-white"> أتمام الشراء </a>
                </div>
            </div>
        </div>
    </div>
</header>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer id="footer" class="footer">

        <div class="footer-newsletter">
            <div class="container">
                <div class="row justify-content-center text-center">
                    <div class="col-lg-6">
                        <h4>اشترك في النشرة الإخبارية</h4>
                        <p>اشترك في نشرتنا الإخبارية وتلق أحدث الأخبار حول منتجاتنا وخدماتنا!</p>
                        <form action="forms/newsletter.php" method="post" class="php-email-form">
                            <div class="newsletter-form"><input type="email" name="email" placeholder="البريد الإلكتروني"><input type="submit" value="اشترك"></div>
                            <div class="loading">جاري التحميل</div>
                            <div class="error-message"></div>
                            <div class="sent-message">تم إرسال طلب الاشتراك. شكراً لك!</div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="container footer-top">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6 footer-about">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="logo d-flex ">
                        <img src="@Url.Content(string.IsNullOrWhiteSpace(companyInformation.LogoUrl) ? "~/Nafas/assets/images/logoo.png" : companyInformation.LogoUrl)" class="w-25" alt="@companyInformation.Name">
                        <h1 class="sitename">@companyInformation.Name</h1>
                    </a>
                    <div class="footer-contact pt-3">
                        <p>@companyInformation.Address</p>
                        @if (!string.IsNullOrWhiteSpace(companyInformation.PhoneNumber))
                        {
                            <p class="mt-3"><strong>الهاتف:</strong> <a href="tel:@companyInformation.PhoneNumber">@companyInformation.PhoneNumber</a></p>
                        }
                        @if (!string.IsNullOrWhiteSpace(companyInformation.Email))
                        {
                            <p><strong>البريد:</strong> <a href="mailto:@companyInformation.Email">@companyInformation.Email</a></p>
                        }
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>روابط مفيدة</h4>
                    <ul>
                        <li><i class="bi bi-chevron-right"></i> <a asp-area="" asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li><i class="bi bi-chevron-right"></i> <a asp-area="" asp-controller="Home" asp-action="About">من نحن</a></li>
                        <li><i class="bi bi-chevron-right"></i> <a asp-area="" asp-controller="Home" asp-action="Services">الخدمات</a></li>
                        <li><a class="nav-link" href="https://www.facebook.com/friends/requests/?profile_id=61573614235805">اتصل بنا</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>خدماتنا</h4>
                    <ul>
                        <li><i class="bi bi-chevron-right"></i> <a href="#">تصميم المواقع</a></li>
                        <li><i class="bi bi-chevron-right"></i> <a href="#">تطوير المواقع</a></li>
                        <li><i class="bi bi-chevron-right"></i> <a href="#">إدارة المنتجات</a></li>
                        <li><i class="bi bi-chevron-right"></i> <a href="#">التسويق</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12">
                    <h4>تابعنا</h4>
                    <p>تابعنا على وسائل التواصل الاجتماعي للحصول على آخر التحديثات.</p>
                    <div class="social-links d-flex">
                        <a href=""><i class="bi bi-twitter-x"></i></a>
                        <a href=""><i class="bi bi-facebook"></i></a>
                        <a href=""><i class="bi bi-instagram"></i></a>
                        <a href=""><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

            </div>
        </div>

        <div class="container copyright text-center mt-4">
            <p>© <span>حقوق النشر</span> <strong class="px-1 sitename">@companyInformation.Name</strong> <span>جميع الحقوق محفوظة</span></p>
           
        </div>

    </footer>

    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Preloader -->

    <script src="~/Admin/plugins/jquery/jquery.min.js"></script>
    <!-- Vendor JS Files -->
    <script src="~/Nafas/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Nafas/assets/vendor/php-email-form/validate.js"></script>
    <script src="~/Nafas/assets/vendor/aos/aos.js"></script>
    <script src="~/Nafas/assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/Nafas/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="~/Admin/plugins/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/Nafas/assets/js/sweetalert.js"></script>
    <script src="~/Nafas/assets/js/main.js"></script>
    <script src="~/Nafas/assets/nav.js"></script>


    <script>
            document.addEventListener('DOMContentLoaded', function () {
                const cartModal = document.getElementById('cartModal');
                const mainContent = document.querySelector('.main-content');

                if (cartModal && mainContent) {
                    cartModal.addEventListener('show.bs.modal', function () {
                        mainContent.classList.add('blurred');
                    });

                    cartModal.addEventListener('hidden.bs.modal', function () {
                        mainContent.classList.remove('blurred');
                    });
                }
            });
    </script>

    <script src="~/Nafas/assets/js/cart.js"></script>
    <script>
        window.isNafathUserSignedIn = @Json.Serialize(SignInManager.IsSignedIn(User));
        window.nafasLoginUrl = '@Url.Page("/Account/Login", new { area = "Identity", returnUrl = Context.Request.Path })';

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.btn-quick-cart, .add-to-cart, #btnAddToCart').forEach(function (button) {
                button.addEventListener('click', function (event) {
                    if (!window.isNafathUserSignedIn) {
                        event.preventDefault();
                        event.stopImmediatePropagation();
                        window.location.href = window.nafasLoginUrl;
                    }
                }, true);
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>

